{
  "name": "karahi-house-voice",
  "version": "1.0.0",
  "private": true,
  "description": "Accent-robust voice AI receptionist for Karahi House SF: takes phone orders, answers menu questions, and understands South Asian accents and dish names.",
  "scripts": {
    "github:check": "node scripts/push-github.mjs",
    "github:push": "node scripts/push-github.mjs --push",
    "test:github": "node --test scripts/github-publication.test.mjs",
    "dev:voice": "tsx scripts/voice-server.ts",
    "start:voice": "tsx scripts/voice-server.ts",
    "test:voice": "tsx --test scripts/voice.test.ts scripts/voice-optimization.test.ts scripts/voice-adaptive.test.ts scripts/voice-reliability.test.ts scripts/voice-playback-continuation.test.ts scripts/voice-buffering.test.ts scripts/voice-access.test.ts scripts/content-audio.test.ts scripts/voice-provenance.test.ts",
    "test:live": "tsx --test --test-concurrency=1 scripts/live-call-patterns.test.ts scripts/real-mic-patterns.test.ts scripts/phonetic-bounds.test.ts scripts/engine-bounds.test.ts scripts/menu-voice-patterns.test.ts scripts/action-safety.test.ts",
    "dev:replay": "tsx scripts/replay-session-dev.ts",
    "voice:analyze": "node scripts/analyze-voice-csv.mjs",
    "voice:cache": "tsx scripts/voice-cache-benchmark.ts",
    "voice:endpointing": "tsx scripts/voice-endpoint-benchmark.ts",
    "voice:adaptive": "tsx scripts/voice-adaptive-benchmark.ts",
    "voice:stt:30": "tsx scripts/voice-stt-script-benchmark.ts",
    "voice:ack": "tsx scripts/voice-ack-benchmark.ts",
    "voice:prerender": "tsx scripts/prerender-voice-audio.ts",
    "voice:export": "tsx scripts/voice-export-logs.ts",
    "voice:deploy:prepare": "node scripts/prepare-voice-deploy.mjs",
    "test:voice:browser": "tsx scripts/voice-browser-test.ts",
    "voice:kokoro": "tsx scripts/voice-kokoro-probe.ts",
    "voice:smoke": "tsx scripts/voice-live-smoke.ts",
    "voice:pronunciation": "node scripts/voice-pronunciation.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:env": "node scripts/check-env.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "typecheck": "tsc --noEmit --incremental false",
    "test:eval": "node --test --test-concurrency=1 scripts/scoring.test.mjs scripts/menu-source.test.mjs scripts/recognition.test.mjs scripts/order-safety.test.mjs scripts/llm-routing.test.mjs scripts/recognition-followups.test.mjs scripts/conversation-format.test.mjs scripts/held-out-report.test.mjs scripts/parser-properties.test.mjs scripts/parser-performance.test.mjs",
    "eval:parser": "node scripts/eval-parser-dev.mjs",
    "eval:performance": "node scripts/benchmark-parser-performance.mjs",
    "eval:burned": "node scripts/eval-burned-regression.mjs",
    "menu:import": "node scripts/import-menu.mjs",
    "menu:check": "node scripts/import-menu.mjs --check",
    "predev": "node scripts/import-menu.mjs --check",
    "prebuild": "node scripts/import-menu.mjs --check && tsx scripts/prerender-voice-audio.ts",
    "eval:menu": "node scripts/eval-current-menu.mjs",
    "eval:text": "node scripts/eval-current-menu.mjs",
    "eval:recognition": "node scripts/eval-current-menu.mjs",
    "eval:routing": "node scripts/eval-current-menu.mjs",
    "eval:audit": "node scripts/eval-current-menu.mjs",
    "eval:messy": "node scripts/eval-current-menu.mjs",
    "eval:simulated": "node scripts/eval-current-menu.mjs",
    "eval:heldout": "node scripts/run-held-out.mjs",
    "eval:baseline": "node scripts/eval-text.mjs --baseline",
    "eval:prepare": "node scripts/prepare-recordings.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "kokoro-js": "1.2.1",
    "next": "15.5.28",
    "phonemizer": "1.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "8.18.2",
    "playwright": "1.58.2",
    "tsx": "4.23.15",
    "typescript": "^5.7.0"
  }
}
