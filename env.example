# Provider credentials (fill locally; never commit actual values)
DEEPGRAM_API_KEY=

# Localhost needs only DEEPGRAM_API_KEY. Public hosting also needs the private
# VOICE_DEMO_ACCESS_TOKEN, generated in Render rather than committed here.
# Empty provider defaults to aura-2; Kokoro remains an explicit alternative.
VOICE_TTS_PROVIDER=
# Aura HTTP is the reliable laptop default; ws is an explicit opt-in.
VOICE_AURA_TRANSPORT=
VOICE_FAQ_ENABLED=
KOKORO_CACHE_DIR=
VOICE_FIXED_AUDIO_CACHE=
# Server persistence is disabled; leave empty or false. CSV exports stay local.
VOICE_PERSIST_LOGS=
VOICE_ENDPOINT_PROFILE=
VOICE_ENDPOINT_MODE=
VOICE_ADAPTIVE_COMPLETE_MS=
# Read-only paired endpoint probes; disabled unless true.
VOICE_ENDPOINT_DIAGNOSTICS=
# Legacy placeholder; neutral acknowledgements are no longer inserted.
VOICE_ACKNOWLEDGEMENT=
VOICE_STATE_KEYTERMS=
VOICE_DEPLOYMENT_LABEL=
VOICE_BIND_ADDRESS=
VOICE_DEMO_ACCESS_TOKEN=
VOICE_REQUIRE_ACCESS_TOKEN=
VOICE_US_BASE_URL=
RENDER_API_KEY=
GITHUB_TOKEN=
GROQ_API_KEY=
VAPI_PRIVATE_KEY=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=

# Set during Vapi setup; not required for the offline text baseline
VAPI_ASSISTANT_ID=
VAPI_SERVER_SECRET=
APP_BASE_URL=

# Optional LLM: disabled by default. Set LLM_PROVIDER to groq to enable.
# GROQ_MODEL defaults to llama-3.1-8b-instant. Use none for fully local turns.
LLM_PROVIDER=
GROQ_MODEL=

# Optional until demo notifications are implemented
RESEND_API_KEY=
DEMO_NOTIFICATION_EMAIL=
